<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  The parts of Filmfold's Info.plist that build settings can't express.
  Xcode merges this with the generated keys (GENERATE_INFOPLIST_FILE).

  CFBundleDocumentTypes: Filmfold can open videos and folders, so they
  can be dropped on its Dock icon and it appears under Finder's Open With.
  "Alternate" means it never becomes the default app for videos.

  NSServices: "Add to Filmfold" in Finder's right-click Services menu.

  CFBundleHelpBook*: Help › Filmfold Help opens Filmfold.help, which is
  bundled with the app and works offline.
-->
<dict>
	<key>CFBundleHelpBookFolder</key>
	<string>Filmfold.help</string>
	<key>CFBundleHelpBookName</key>
	<string>com.minegene.filmfold.help</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Add to Filmfold</string>
			</dict>
			<key>NSMessage</key>
			<string>addFiles</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.movie</string>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
